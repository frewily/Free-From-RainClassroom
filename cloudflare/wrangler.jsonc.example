{
  // 示例不会被 Wrangler 自动发现；复制为 wrangler.jsonc 后再编辑。
  // 使用自己的全新 Worker 名称，勿填现有生产 Worker 名称进行试部署。
  "name": "replace-me-rainclassroom-dev",
  "main": "worker.js",
  // 新部署的兼容日期示例，不代表控制台生产环境当前使用的日期。
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "TRIGGER_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  // 新实例默认不注册 Cron。核对仓库目标、Secrets、KV 和源码开关后，
  // 由部署者将 [] 改为 ["*/5 * * * *"] 才启用自动调度。
  "triggers": {
    "crons": []
  },
  // 当前源码不读取普通环境变量；无需配置 vars。
  // AUTO_DISPATCH、REPO 等为 worker.js 常量，不是 vars。
  // GITHUB_TOKEN / TEST_TRIGGER_KEY 用 wrangler secret put 或控制台配置。
  "vars": {}
}
